    "@housing/shared": "workspace:*",
    "@housing/sources": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^7.0.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
