# Copy to .env. Every value is optional. The app generates APP_SECRET and NTFY_COMMAND_TOPIC on first run.
PORT=4747
DATA_DIR=./data

APP_SECRET=
NTFY_COMMAND_TOPIC=
# Only for a self-hosted or paid ntfy server that requires auth
NTFY_TOKEN=

# Outgoing mail. For Gmail: host smtp.gmail.com, port 465, and an app password (not your login password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional. Personalizes outreach drafts with Claude.
ANTHROPIC_API_KEY=

# Optional. Set this when the dashboard is reachable from the public internet.
DASHBOARD_PASSWORD=
